{
  "name": "pedi-svelte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pediatric dose calculator for healthcare professionals (PWA) – Svelte 5",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "svelte": "^5.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.25.0",
    "eslint-plugin-svelte": "^3.5.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte-check": "^4.1.0",
    "svelte-eslint-parser": "^1.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.2"
  },
  "packageManager": "bun@1.3.14"
}
